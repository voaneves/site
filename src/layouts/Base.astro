---
import Logo from '@voaneves/brand/astro/Logo.astro';
import Icon from '../components/Icon.astro';
import Credit from '@voaneves/brand/astro/Credit.astro';
import '../styles/site.css';
import { UI, type Locale } from '../i18n/ui';
import { SEO } from '../i18n/seo';
import { PORTFOLIO } from '../data/portfolio';
import { alternatePathForLocale, routeAlternates } from '../i18n/routes.mjs';

export interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  schemaJson?: object[];
  preloadHeroImage?: string;
  preloadHeroSrcset?: string;
  preloadHeroSizes?: string;
}

const {
  locale = 'pt-br',
  title,
  description,
  schemaJson = [],
  preloadHeroImage,
  preloadHeroSrcset,
  preloadHeroSizes,
} = Astro.props;

const t = UI[locale];
const c = PORTFOLIO[locale];
const seo = SEO[locale];
const htmlLang = locale === 'en' ? 'en' : 'pt-BR';
const pageTitle = title ?? t.metaTitleHome;
const pageDescription = description ?? t.metaDescHome;

const siteOrigin = Astro.site ?? 'https://voaneves.com';
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const ogImageUrl = new URL('/assets/img/og-img.webp', siteOrigin).toString();
const alternates = routeAlternates(canonicalUrl);
// An error page has no canonical: its pathname (/404/) is not a URL that exists.
const isErrorPage = /^\/404\/?$/.test(Astro.url.pathname);
const targetLocale: Locale = locale === 'en' ? 'pt-br' : 'en';
const switchHref = alternatePathForLocale(Astro.url.pathname, targetLocale);
const homePrefix = locale === 'en' ? '/en/' : '/';
const privacyHref = locale === 'en' ? '/en/privacy/' : '/privacidade/';
const normalizedPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isHome = normalizedPath === '/' || normalizedPath === '/en/';
const navTarget = (hash: string) => (isHome ? `#${hash}` : `${homePrefix}#${hash}`);

const navLinks = [
  { n: '01', hash: 'quem-sou', label: t.navAbout },
  { n: '02', hash: 'numeros', label: t.navNumbers },
  { n: '03', hash: 'jornada', label: t.navJourney },
  { n: '04', hash: 'projetos', label: t.navProjects },
  { n: '05', hash: 'servicos', label: t.navServices },
  { n: '06', hash: 'perguntas', label: t.navFaq },
  { n: '07', hash: 'contato', label: t.navContact },
];

const defaultSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Victor Neves',
    alternateName: 'voaneves',
    url: 'https://voaneves.com',
    image: ogImageUrl,
    jobTitle: seo.jobTitle,
    description: pageDescription,
    alumniOf: {
      '@type': 'CollegeOrUniversity',
      name: seo.alumniOf,
    },
    worksFor: {
      '@type': 'Organization',
      name: 'SEBRAE Tocantins',
    },
    knowsLanguage: ['pt-BR', 'en', 'es', 'ko', 'de'],
    award: seo.awards,
    sameAs: [
      'https://github.com/voaneves',
      'https://www.linkedin.com/in/voaneves/',
      'https://www.youtube.com/@voaneves',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'voaneves — Victor Neves',
    url: 'https://voaneves.com',
    areaServed: [
      { '@type': 'Country', name: seo.areaServedCountry },
      { '@type': 'City', name: 'Palmas' },
    ],
    priceRange: seo.priceRange,
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: seo.catalogName,
      itemListElement: c.services.items.map((s) => ({
        '@type': 'Offer',
        name: s.title,
        description: s.description,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'voaneves',
    url: 'https://voaneves.com',
    inLanguage: seo.inLanguage,
  },
];

const graphs = schemaJson.length > 0 ? schemaJson : defaultSchema;
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---
<!doctype html>
<html lang={htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="theme-color" content="#0a0a0a" />
  {!isErrorPage && <link rel="canonical" href={canonicalUrl} />}
  {alternates.map((alt) => (
    <link rel="alternate" hreflang={alt.lang} href={alt.url} />
  ))}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  {!isErrorPage && <meta property="og:url" content={canonicalUrl} />}
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={ogImageUrl} />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {/* The manifest link is added by src/scripts/after-lcp.ts: fetched in the head it (and its icon) lands inside the LCP window. */}
  {preloadHeroImage && (
    <link rel="preload" as="image" type="image/webp" href={preloadHeroImage} imagesrcset={preloadHeroSrcset} imagesizes={preloadHeroSizes} fetchpriority="high" />
  )}
  {graphs.map((entry) => (
    <script type="application/ld+json" set:html={JSON.stringify(entry)} />
  ))}
  {/* pagereveal: marks the document while a navigation view transition reveals it (page counter). */}
  <script is:inline>
    (() => {
      document.documentElement.classList.add('js');
      addEventListener('pagereveal', (e) => {
        if (!e.viewTransition) return;
        document.documentElement.classList.add('vn-vt');
        const clean = () => document.documentElement.classList.remove('vn-vt');
        e.viewTransition.finished.then(clean, clean);
      });
      try {
        const s = localStorage.getItem('vn-theme');
        const m = s === 'light' || s === 'dark' ? s : matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = m;
        document.querySelector('meta[name=theme-color]')?.setAttribute('content', m === 'dark' ? '#0a0a0a' : '#fdfbf6');
        if (localStorage.getItem('vn-fonts') === '1') document.documentElement.classList.add('vn-fonts');
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    })();
  </script>
  {cfBeaconToken && (
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfBeaconToken })} />
  )}
</head>
<body>
  <a class="vn-skip-link" href="#main">{t.skipToContent}</a>
  {isHome && (
    <div class="vn-rail" aria-hidden="true" hidden>
      <span class="vn-rail__n"></span>
      <span class="vn-rail__line"><i></i></span>
      <span class="vn-rail__cue"></span>
    </div>
  )}
  <div class="vn-scroll-progress" id="vn-scroll-progress" aria-hidden="true"></div>
  <div class="vn-vt-count" aria-hidden="true"></div>

  <header class="vn-navbar">
    <div class="vn-container vn-navbar__inner">
      <a class="vn-navbar__brand" href={homePrefix} aria-label="voaneves">
        <Logo variant="signature" tone="mono" />
      </a>

      <nav class="vn-navbar__nav" aria-label={t.navLabel}>
        {navLinks.map((item) => (
          <a class="vn-type-label vn-navbar__link" href={navTarget(item.hash)} data-nav-hash={item.hash} data-fx="roll">
            <span><span>{item.label}</span></span>
          </a>
        ))}
      </nav>

      <div class="vn-navbar__actions">
        <a class="vn-btn vn-btn--ghost vn-btn--sm" href={switchHref} aria-label={t.langSwitchLabel}>
          {t.langSwitchText}
        </a>
        <button
          id="vn-theme-toggle"
          class="vn-icon-btn"
          type="button"
          aria-label={t.themeToggleLabel}
        >
          <Icon name="adjust" size={18} />
        </button>
        <a class="vn-btn vn-btn--primary vn-btn--sm vn-navbar__cta" href={navTarget('contato')} data-magnetic data-cursor-label={locale === 'en' ? 'TALK' : 'CONVERSAR'}>
          <span class="vn-btn__dot" aria-hidden="true"></span>
          <span>{t.bookCall}</span>
        </a>
        <button
          id="vn-menu-btn"
          class="vn-icon-btn vn-navbar__menu-btn"
          type="button"
          aria-label={t.menuOpen}
          aria-controls="vn-mobile-drawer"
          aria-expanded="false"
        >
          <span class="vn-menu-bars" aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </header>

  <dialog
    id="vn-mobile-drawer"
    class="vn-mobile-drawer"
    aria-label={locale === 'en' ? 'Mobile navigation drawer' : 'Menu de navegação móvel'}
  >
    <div class="vn-mobile-drawer__head">
      <Logo variant="signature" tone="reverse" />
      <button id="vn-drawer-close" class="vn-icon-btn vn-drawer-close" type="button" aria-label={t.menuClose}>
        ×
      </button>
    </div>

    <nav class="vn-mobile-drawer__nav" aria-label={locale === 'en' ? 'Mobile navigation' : 'Navegação móvel'}>
      {navLinks.map((item) => (
        <a class="vn-drawer__link" href={navTarget(item.hash)} data-drawer-link>
          <span class="vn-type-h3">{item.label}</span>
          <span class="vn-type-label vn-drawer-num">{item.n}</span>
        </a>
      ))}
    </nav>

    <div class="vn-mobile-drawer__foot">
      <a class="vn-btn vn-btn--signal vn-btn--md" href={navTarget('contato')} data-drawer-link>
        <span class="vn-btn__dot" aria-hidden="true"></span>
        <span>{t.bookCall}</span>
      </a>
      <a class="vn-btn vn-btn--secondary vn-btn--md vn-drawer-btn-light" href={c.contact.cvUrl} download>
        <Icon name="cloud-download" size={18} />
        <span>{t.downloadCv}</span>
      </a>
      <a class="vn-btn vn-btn--ghost vn-btn--sm vn-drawer-btn-light" href={switchHref} aria-label={t.langSwitchLabel}>
        {t.langSwitchText}
      </a>
    </div>
  </dialog>

  <main id="main">
    <slot />
  </main>

  <footer class="vn-site-footer" data-cursor-zone="read">
    <div class="vn-container vn-site-footer__inner">
      <div data-enter="left"><Credit variant="inline" lang={locale === 'en' ? 'en' : 'pt-BR'} utmSource="voaneves-site" /></div>
      <p class="vn-type-micro vn-foot-time" data-enter><span>Palmas, TO</span> · <span data-vn-clock>UTC−3</span></p>
      <div class="vn-site-footer__links" data-enter="right">
        <a class="vn-type-micro" href={privacyHref} data-fx="roll"><span><span>{t.footerPrivacy}</span></span></a>
        <a class="vn-type-micro" href={c.contact.cvUrl} download data-fx="roll"><span><span>{locale === 'en' ? 'CV PDF (PT)' : 'CV PDF'}</span></span></a>
        <a class="vn-type-micro" href="https://github.com/voaneves" rel="noopener noreferrer" target="_blank" data-fx="roll"><span><span>GitHub</span></span></a>
        <a class="vn-type-micro" href="https://www.linkedin.com/in/voaneves/" rel="noopener noreferrer" target="_blank" data-fx="roll"><span><span>LinkedIn</span></span></a>
        <a class="vn-type-micro" href="https://www.youtube.com/@voaneves" rel="noopener noreferrer" target="_blank" data-fx="roll"><span><span>YouTube</span></span></a>
      </div>
    </div>
    <p class="vn-foot-mark" aria-hidden="true" hidden><span>voaneves<i>.</i></span></p>
  </footer>

  <script>import '../scripts/main.ts';</script>
</body>
</html>
