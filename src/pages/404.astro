---
import Base from '../layouts/Base.astro';
import { UI } from '../i18n/ui';

const pt = UI['pt-br'];
const en = UI.en;
---

<Base locale="pt-br" title={pt.notFoundMetaTitle} description={`${pt.notFoundMetaDesc} / ${en.notFoundMetaDesc}`}>
  <section class="vn-section">
    <div class="vn-container vn-measure">
      <p class="vn-type-tag vn-beat">404</p>
      <h1 class="vn-type-h1 vn-beat">{pt.notFoundTitle}</h1>
      <p class="vn-type-lead vn-beat">{pt.notFoundLead}</p>
      <div class="vn-site-hero__actions">
        <a class="vn-btn vn-btn--primary vn-btn--md" href="/">{pt.backHome}</a>
      </div>
      <div lang="en">
        <p class="vn-type-lead vn-beat">{en.notFoundTitle} {en.notFoundLead}</p>
        <div class="vn-site-hero__actions">
          <a class="vn-btn vn-btn--secondary vn-btn--md" href="/en/">{en.backHome}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
