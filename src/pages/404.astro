---
import Base from '../layouts/Base.astro';
---

<Base locale="pt-br" title="404 — Victor Neves" description="Página não encontrada / Page not found.">
  <section class="vn-section">
    <div class="vn-container vn-measure">
      <p class="vn-type-tag vn-beat">404</p>
      <h1 class="vn-type-h1 vn-beat">Essa página saiu do mapa.</h1>
      <p class="vn-type-lead vn-beat">Page not found. Volta pro início?</p>
      <div class="vn-site-hero__actions">
        <a class="vn-btn vn-btn--primary vn-btn--md" href="/">Início (PT)</a>
        <a class="vn-btn vn-btn--secondary vn-btn--md" href="/en/">Home (EN)</a>
      </div>
    </div>
  </section>
</Base>
