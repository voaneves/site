---
import Hero from './home/Hero.astro';
import About from './home/About.astro';
import Numbers from './home/Numbers.astro';
import Expertise from './home/Expertise.astro';
import Journey from './home/Journey.astro';
import Projects from './home/Projects.astro';
import Services from './home/Services.astro';
import Faq from './home/Faq.astro';
import Contact from './home/Contact.astro';
import type { Locale } from '../i18n/ui';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Hero locale={locale} />
<About locale={locale} />
<Numbers locale={locale} />
<Expertise locale={locale} />
<Journey locale={locale} />
<Projects locale={locale} />
<Services locale={locale} />
<Faq locale={locale} />
<Contact locale={locale} />
