---
import Icon from '../Icon.astro';
import { UI, type Locale } from '../../i18n/ui';
import { PORTFOLIO } from '../../data/portfolio';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];
const c = PORTFOLIO[locale];
const projectBase = locale === 'en' ? '/en/projects' : '/projetos';
const badgeLoop = `${c.hero.badgeText}${c.hero.badgeText}`;
// Display name: "Victor / Neves" (the data keeps the caps used elsewhere).
const nameCase = (s: string) => s.charAt(0) + s.slice(1).toLowerCase();
// Touch caption (the data caption says "hover"); swapped in by CSS on coarse pointers.
const L = {
  'pt-br': { tap: 'Toque para revelar em cor' },
  en: { tap: 'Tap to reveal full color' },
} as const;
const l = L[locale];
const idle = [c.hero.essence.replace(/[.,]/g, '').replace(' ', '·').toUpperCase(), 'PALMAS·TO', c.hero.ctaPrimary.replace(' ', '·').toUpperCase()].join('|');
---

<section id="inicio" class="vn-hero vn-site-anchor-target" data-surface="inverse" data-cursor-zone="ring" data-cursor-idle={idle}>
  <span id="home" class="vn-sr-only"></span>
  <div class="vn-hero__grid" aria-hidden="true"></div>

  <div class="vn-container vn-hero__inner">
    <div class="vn-hero__strip">
      <div class="vn-hero__meta">
        <span class="vn-status-pill vn-hero-pill">
          <span class="vn-status-pill__dot" aria-hidden="true"></span>
          <span>{t.statusAvailable}</span>
        </span>
        <span class="vn-type-tag vn-hero__kicker">{c.hero.kicker}</span>
      </div>
      <p class="vn-hero__hud" aria-hidden="true" data-vn-hud>
        <span class="vn-hero__hud-live" data-vn-hud-live>X 0000 · Y 0000 · 2026</span>
        {/* Palmas, TO: shown instead of the live readout on touch, reduced motion and no JS. */}
        <span class="vn-hero__hud-static">-10.2° · -48.3° · 2026</span>
      </p>
    </div>

    <div class="vn-hero__copy">
      <h1 class="vn-hero__title">
        <span class="vn-hero__line">{nameCase(c.hero.firstName)}</span>
        <span class="vn-hero__line vn-hero__line--accent">{nameCase(c.hero.lastName)}<span class="vn-hero__dot" aria-hidden="true"></span></span>
        <span class="vn-hero__role"> — {c.hero.role}</span>
      </h1>

      <p class="vn-hero__strap">{c.hero.essence}</p>
      <p class="vn-type-lead vn-hero__sub">{c.hero.sub}</p>

      <div class="vn-hero__actions">
        <a
          class="vn-btn vn-btn--signal vn-btn--lg vn-magnetic" data-magnetic
          href="#contato"
          data-cursor-label={locale === 'en' ? 'START' : 'INICIAR'}
        >
          <span class="vn-btn__dot" aria-hidden="true"></span>
          <span>{c.hero.ctaPrimary}</span>
        </a>
        <a
          class="vn-btn vn-btn--secondary vn-btn--lg vn-hero-btn-ghost vn-magnetic" data-magnetic
          href="#projetos"
          data-cursor-label={locale === 'en' ? 'WORK' : 'PROJETOS'}
        >
          <span>{c.hero.ctaSecondary}</span>
        </a>
        <a
          class="vn-btn vn-btn--ghost vn-btn--lg vn-hero-btn-cv"
          href={c.contact.cvUrl}
          download
        >
          <Icon name="cloud-download" size={18} />
          <span>{c.hero.ctaCv}</span>
        </a>
      </div>
    </div>

    <div class="vn-hero__stage" data-vn-hero-stage>
      <div class="vn-hero-portrait" data-vn-portrait-wrap>
        <img
          src="/assets/img/main_1.webp"
          alt={c.hero.portraitAlt}
          width="333"
          height="500"
          loading="eager"
          decoding="sync"
          fetchpriority="high"
          class="vn-hero-portrait__img"
        />
        <canvas class="vn-hero-portrait__canvas" width="333" height="500" aria-hidden="true"></canvas>
        <div class="vn-hero-portrait__frame" aria-hidden="true"></div>
        <span class="vn-hero-portrait__hint vn-type-micro"
          ><span class="vn-hero-portrait__hint-hover">{c.hero.portraitCaption}</span
          ><span class="vn-hero-portrait__hint-tap">{l.tap}</span></span
        >
      </div>

      {c.hero.chips.map((chip) => (
        <div
          class={`vn-hero-chip vn-hero-chip--${chip.pos}`}
          data-depth={chip.depth}
        >
          <span class="vn-hero-chip__dot" aria-hidden="true"></span>
          <span>{chip.label}</span>
        </div>
      ))}

      <div class="vn-hero-badge" aria-hidden="true">
        <span class="vn-hero-badge__turn">
          <svg viewBox="0 0 120 120" width="112" height="112" class="vn-hero-badge__svg">
            <defs>
              <path id={`badge-circle-${locale}`} d="M 60, 60 m -44, 0 a 44,44 0 1,1 88,0 a 44,44 0 1,1 -88,0" />
            </defs>
            <text font-size="8.2" font-weight="700" letter-spacing="2.2">
              <textPath href={`#badge-circle-${locale}`}>{badgeLoop}</textPath>
            </text>
          </svg>
        </span>
        <span class="vn-hero-badge__center">VN</span>
      </div>
    </div>
  </div>
</section>

<!-- Sections below the fold are rendered on demand (content-visibility), so fraunces-roman is no longer
     requested by the first layout. Warm it right after LCP (wide screens: immediately) so the swap never
     lands inside a section the visitor is already scrolling through. -->
<script>
  (() => {
    let warmed = false;
    const warm = () => {
      if (warmed) return;
      warmed = true;
      try {
        document.fonts.load('400 1em Fraunces');
      } catch {}
    };
    if (matchMedia('(min-width: 1024px)').matches) {
      warm();
      return;
    }
    try {
      new PerformanceObserver(warm).observe({ type: 'largest-contentful-paint', buffered: true });
    } catch {}
    addEventListener('load', () => setTimeout(warm, 1500));
  })();
</script>
