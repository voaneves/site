---
import type { Locale } from '../../i18n/ui';
import { PORTFOLIO } from '../../data/portfolio';
import Words from '../Words.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = PORTFOLIO[locale];
const [eyebrowNum, ...eyebrowRest] = (c.projects.tag).split(' · ');
const eyebrowTag = eyebrowRest.join(' · ');
const splitTail = (s: string): [string, string] => {
  const w = s.split(' ');
  const n = w.length > 3 ? 2 : 1;
  return [w.slice(0, -n).join(' ') + ' ', w.slice(-n).join(' ')];
};
const [titlePre, titleEm] = splitTail(c.projects.title);
const projectBase = locale === 'en' ? '/en/projects' : '/projetos';
const L = { 'pt-br': { cta: 'Ver case' }, en: { cta: 'View case' } }[locale];
---

<section data-section="05" id="projetos" class="vn-section vn-site-anchor-target" data-cursor-zone="view" data-cursor-idle={locale === 'en' ? 'CASES|WORK' : 'CASES|PROJETOS'}>
  <span id="portfolio" class="vn-sr-only"></span>
  <div class="vn-container">
    <div class="vn-sec-head" data-stagger>
      <p class="vn-eyebrow" data-enter><span aria-hidden="true">[ {eyebrowNum} — </span>{eyebrowTag}<span aria-hidden="true"> ]</span></p>
      <h2 class="vn-type-h2 vn-split-title" data-enter="mask"><Words text={titlePre} /><em><Words text={titleEm} /></em></h2>
      <p class="vn-type-body vn-muted vn-measure vn-sec-sub" data-enter="lines">{c.projects.subtitle}</p>
    </div>

    <div class="vn-projects-list">
      {c.projects.items.map((proj, idx) => (
        <a
          class="vn-work-row vn-project-row"
          href={`${projectBase}/${proj.slug}/`}
          data-cursor-label={`${L.cta} →`}
        >
          <div class="vn-project-row__left" data-enter={idx % 2 ? 'right' : 'left'}>
            <span class="vn-type-price vn-project-row__idx">{proj.index}</span>
            <div class="vn-project-row__media" data-enter="clip" data-vt={proj.slug}>
              <img
                src={proj.image}
                alt={proj.imageAlt}
                width="1600"
                height="800"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="vn-project-row__text">
              <span class="vn-type-micro vn-muted">{proj.category} · {proj.year}</span>
              <h3 class="vn-type-h3">{proj.title}</h3>
              <p class="vn-type-body-sm vn-muted">{proj.summary}</p>
            </div>
          </div>

          <div class="vn-project-row__right" data-enter>
            <span class="vn-chip vn-project-row__metric">{proj.metricBadge}</span>
            <span class="vn-type-label vn-project-row__cta">{L.cta} →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
