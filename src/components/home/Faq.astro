---
import type { Locale } from '../../i18n/ui';
import { PORTFOLIO } from '../../data/portfolio';
import Words from '../Words.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = PORTFOLIO[locale];
const [eyebrowNum, ...eyebrowRest] = (c.faq.tag).split(' · ');
const eyebrowTag = eyebrowRest.join(' · ');
const splitTail = (s: string): [string, string] => {
  const w = s.split(' ');
  const n = w.length > 3 ? 2 : 1;
  return [w.slice(0, -n).join(' ') + ' ', w.slice(-n).join(' ')];
};
const [titlePre, titleEm] = splitTail(c.faq.title);
---

<section data-section="07" id="perguntas" class="vn-section vn-chapter--creme vn-faq-chapter vn-site-anchor-target" data-cursor-zone="read">
  <span id="faq" class="vn-sr-only"></span>
  <div class="vn-container vn-faq-layout">
    <div class="vn-faq-head" data-stagger>
      <p class="vn-eyebrow" data-enter data-fx="scramble"><span aria-hidden="true">[ {eyebrowNum} — </span>{eyebrowTag}<span aria-hidden="true"> ]</span></p>
      <h2 class="vn-type-h2 vn-split-title" data-enter="mask"><Words text={titlePre} /><em><Words text={titleEm} /></em></h2>
      <p class="vn-type-body vn-muted" data-enter>{c.faq.subtitle}</p>
    </div>

    <div class="vn-faq-list" data-stagger>
      {c.faq.items.map((item) => (
        <details name={`faq-${locale}`} class="vn-faq-item" data-enter="right">
          <summary class="vn-faq-item__q" data-cursor-label={locale === 'en' ? 'Open' : 'Abrir'}>
            <span class="vn-type-body-strong">{item.q}</span>
            <span class="vn-faq-item__icon" aria-hidden="true">+</span>
          </summary>
          <p class="vn-type-body-sm vn-muted vn-faq-item__a">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
