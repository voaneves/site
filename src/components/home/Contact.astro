---
import Icon from '../Icon.astro';
import type { Locale } from '../../i18n/ui';
import { PORTFOLIO } from '../../data/portfolio';
import Words from '../Words.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = PORTFOLIO[locale];
const [eyebrowNum, ...eyebrowRest] = (c.contact.tag).split(' · ');
const eyebrowTag = eyebrowRest.join(' · ');

const L = {
  'pt-br': { line: 'Bora fazer', em: 'sinal', end: '?' },
  en: { line: "Let's make", em: 'signal', end: '?' },
}[locale];
---

<section data-section="08" id="contato" class="vn-section vn-contact-band vn-site-anchor-target" data-surface="signal" data-ground="signal" data-enter="wipe" data-trail="off" data-cursor-zone="signal">
  <span id="contact" class="vn-sr-only"></span>
  <div class="vn-container">
    <div class="vn-contact-top" data-stagger>
      <p class="vn-eyebrow" data-enter><span aria-hidden="true">[ {eyebrowNum} — </span>{eyebrowTag}<span aria-hidden="true"> ]</span></p>
      <span class="vn-contact-sla" data-enter="right">{c.contact.sla}</span>
    </div>

    <h2 class="vn-type-display vn-contact-title" data-enter="mask"><span class="vn-contact-l1" data-drift><Words text={L.line} /></span> <em data-drift><Words text={L.em + L.end} /></em></h2>
    <p class="vn-type-lead vn-contact-sub vn-measure" data-enter="lines">{c.contact.subtitle}</p>

    <div class="vn-contact-actions" data-enter>
      <a
        class="vn-btn vn-btn--primary vn-btn--xl vn-magnetic" data-magnetic
        href={c.contact.koalendarUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="calendar-check" size={20} />
        <span>{c.contact.koalendarLabel}</span>
      </a>

      <a
        class="vn-btn vn-btn--secondary vn-btn--xl vn-contact-secondary vn-magnetic" data-magnetic
        href={c.contact.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="whatsapp" size={20} />
        <span>{c.contact.whatsappLabel}</span>
      </a>

      <a
        class="vn-btn vn-btn--secondary vn-btn--xl vn-contact-secondary"
        href={`mailto:${c.contact.emailAddress}`}
      >
        <Icon name="envelope-open" size={20} />
        <span>{c.contact.emailLabel}</span>
      </a>

      <a
        class="vn-btn vn-btn--secondary vn-btn--xl vn-contact-secondary"
        href={c.contact.cvUrl}
        download
      >
        <Icon name="cloud-download" size={20} />
        <span>{c.contact.cvLabel}</span>
      </a>
    </div>

    <p class="vn-type-caption vn-contact-note" data-enter>{c.contact.note}</p>
  </div>
</section>
