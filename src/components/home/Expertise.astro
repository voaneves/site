---
import type { Locale } from '../../i18n/ui';
import { PORTFOLIO } from '../../data/portfolio';
import Words from '../Words.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = PORTFOLIO[locale];
const [eyebrowNum, ...eyebrowRest] = (c.expertise.tag).split(' · ');
const eyebrowTag = eyebrowRest.join(' · ');
const splitTail = (s: string): [string, string] => {
  const w = s.split(' ');
  const n = w.length > 3 ? 2 : 1;
  return [w.slice(0, -n).join(' ') + ' ', w.slice(-n).join(' ')];
};
const [titlePre, titleEm] = splitTail(c.expertise.title);
const idle = c.expertise.pillars.slice(0, 3).map((p) => p.title.split(/[ ,&]/)[0].toUpperCase()).join('|');
---

<section data-section="03" id="expertise" class="vn-section vn-chapter--creme vn-site-anchor-target" data-cursor-zone="plus" data-cursor-idle={idle}>
  <div class="vn-container">
    <div class="vn-sec-split">
      <div data-stagger>
        <p class="vn-eyebrow" data-enter data-fx="scramble"><span aria-hidden="true">[ {eyebrowNum} — </span>{eyebrowTag}<span aria-hidden="true"> ]</span></p>
        <h2 class="vn-type-h2 vn-split-title" data-enter="mask"><Words text={titlePre} /><em><Words text={titleEm} /></em></h2>
      </div>
      <div data-enter="right">
        <button
          type="button"
          class="vn-btn vn-btn--secondary vn-btn--sm"
          data-marquee-toggle
          data-label-pause={c.expertise.pauseLabel}
          data-label-resume={c.expertise.resumeLabel}
          aria-pressed="false"
        >
          {c.expertise.pauseLabel}
        </button>
      </div>
    </div>
  </div>

  <div class="vn-marquee-stack" data-vn-marquee-root data-enter="clip">
    {c.expertise.tracks.map((track, idx) => (
      <div class={`vn-marquee vn-marquee--${idx % 2 === 1 ? 'rev' : 'fwd'}`}>
        <div class="vn-marquee__track">
          {[...track, ...track].map((item, jdx) => (
            <span class={`vn-marquee__item ${(idx + jdx) % 2 === 1 ? 'vn-marquee__item--accent' : ''}`}>
              {item}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="vn-container">
    <div class="vn-pillars-grid" data-stagger>
      {c.expertise.pillars.map((pillar) => (
        <article class="vn-pillar-card" data-enter data-fx="tilt">
          <h3 class="vn-type-h4">{pillar.title}</h3>
          <ul class="vn-chip-list">
            {pillar.items.map((item) => (
              <li class="vn-chip">{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
