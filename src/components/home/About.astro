---
import type { Locale } from '../../i18n/ui';
import { PORTFOLIO } from '../../data/portfolio';
import Words from '../Words.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = PORTFOLIO[locale];
const [eyebrowNum, ...eyebrowRest] = (c.about.tag).split(' · ');
const eyebrowTag = eyebrowRest.join(' · ');
---

<section data-section="01" id="quem-sou" class="vn-section vn-chapter--creme vn-site-anchor-target" data-cursor-zone="read">
  <span id="who" class="vn-sr-only"></span>
  <div class="vn-container">
    <div class="vn-sec-head">
      <p class="vn-eyebrow" data-enter="right" data-fx="scramble"><span aria-hidden="true">[ {eyebrowNum} — </span>{eyebrowTag}<span aria-hidden="true"> ]</span></p>
    </div>

    <div class="vn-about-stage">
      <h2 class="vn-type-h1 vn-about-statement" data-enter="mask">
        <Words text={c.about.statementPre} /><Words text={c.about.statementEm1} em /><Words text={c.about.statementMid} /><Words text={c.about.statementEm2} em tail={c.about.statementPost} />
      </h2>
      <p class="vn-type-body-sm vn-muted vn-about-cap" data-enter>{c.about.p2}</p>
    </div>

    <div class="vn-about-grid">
      <div class="vn-about-prose" data-stagger>
        <p class="vn-type-lead" data-enter="lines">{c.about.p1}</p>
      </div>

      <dl class="vn-spec-list" data-stagger>
        {c.about.specs.map((spec) => (
          <div class="vn-spec-list__row" data-enter="right">
            <dt class="vn-type-label vn-muted">{spec.k}</dt>
            <dd class="vn-type-body-strong">{spec.v}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="vn-awards-wrap">
      <h3 class="vn-type-label vn-awards-title" data-enter>{c.about.awardsTitle}</h3>
      <div class="vn-awards-grid" data-stagger>
        {c.about.awards.map((award) => (
          <article class="vn-award-card" data-enter="scale" data-fx="tilt">
            <span class="vn-award-card__place">{award.place}</span>
            <h4 class="vn-type-body-strong vn-award-card__title">{award.title}</h4>
            <p class="vn-type-body-sm vn-award-card__detail">{award.detail}</p>
            <p class="vn-type-micro vn-muted">{award.meta}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
