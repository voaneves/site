---
import type { Locale } from '../../i18n/ui';
import { PORTFOLIO } from '../../data/portfolio';
import Words from '../Words.astro';
import { aboutTimeline } from '../../data/about-timeline';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = PORTFOLIO[locale];
const [eyebrowNum, ...eyebrowRest] = (c.about.tag).split(' · ');
const eyebrowTag = eyebrowRest.join(' · ');
const L = {
  'pt-br': { drag: 'Arraste', prev: 'Conquista anterior', next: 'Próxima conquista' },
  en: { drag: 'Drag', prev: 'Previous award', next: 'Next award' },
}[locale];
const [, ...tlRest] = c.journey.tag.split(' · ');
const tlTitle = tlRest.join(' · ');
const timeline = aboutTimeline(c);
const total = String(c.about.awards.length).padStart(2, '0');
---

<section data-section="01" id="quem-sou" class="vn-section vn-chapter--creme vn-site-anchor-target" data-cursor-zone="read">
  <span id="who" class="vn-sr-only"></span>
  <div class="vn-container">
    <div class="vn-sec-head">
      <p class="vn-eyebrow" data-enter="right" data-fx="scramble"><span aria-hidden="true">[ {eyebrowNum} — </span>{eyebrowTag}<span aria-hidden="true"> ]</span></p>
    </div>

    <div class="vn-about-stage">
      <h2 class="vn-type-h1 vn-about-statement" data-enter="mask">
        <Words text={c.about.statementPre} /><Words text={c.about.statementEm1} em /><Words text={c.about.statementMid} /><Words text={c.about.statementEm2} em tail={c.about.statementPost} />
      </h2>
      <p class="vn-type-body-sm vn-muted vn-about-cap" data-enter>{c.about.p2}</p>
    </div>

    <div class="vn-about-grid">
      <div class="vn-about-portrait" aria-hidden="true">
        <img src="/assets/img/main_1.webp" alt="" width="333" height="500" loading="lazy" decoding="async" class="vn-about-portrait__base" />
        <img src="/assets/img/main_1.webp" alt="" width="333" height="500" loading="lazy" decoding="async" class="vn-about-portrait__ink" />
      </div>
      <div class="vn-about-col">
        <div class="vn-about-prose" data-stagger>
          <p class="vn-type-lead" data-enter="lines">{c.about.p1}</p>
        </div>
        <div class="vn-about-tl" data-stagger>
          <h3 class="vn-type-label vn-muted" data-enter>{tlTitle}</h3>
          <ol class="vn-about-tl__list" data-stagger>
            {timeline.map((item) => (
              <li class="vn-timeline-item" data-enter data-current={item.current ? '' : undefined}>
                <p class="vn-type-label vn-about-tl__period">{item.period}</p>
                <h4 class="vn-type-h4">{item.org}</h4>
                {item.role && <p class="vn-type-body-strong">{item.role}</p>}
                <ul class="vn-about-tl__sub">
                  {item.sub.map((s) => <li class="vn-type-caption">{s}</li>)}
                </ul>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>

    <div class="vn-awards-wrap">
      <h3 class="vn-type-label vn-awards-title" id="vn-awards-title" data-enter>{c.about.awardsTitle}</h3>
      <div class="vn-journey-controls" data-enter>
        <span class="vn-type-micro vn-muted vn-journey-hint">{c.journey.dragHint}</span>
        <span class="vn-journey-count vn-type-micro" data-car-count>01 / {total}</span>
        <button type="button" class="vn-icon-btn" data-car-prev aria-label={L.prev}>←</button>
        <button type="button" class="vn-icon-btn" data-car-next aria-label={L.next}>→</button>
      </div>
    </div>
  </div>

  <div
    class="vn-journey-track vn-awards-track"
    data-vn-car
    data-cursor-zone="drag"
    data-cursor-label={L.drag}
    tabindex="0"
    role="region"
    aria-labelledby="vn-awards-title"
  >
    {c.about.awards.map((award) => (
      <article class="vn-award-card">
        <span class="vn-award-card__place">{award.place}</span>
        <h4 class="vn-type-body-strong vn-award-card__title">{award.title}</h4>
        <p class="vn-type-body-sm vn-award-card__detail">{award.detail}</p>
        <p class="vn-type-micro vn-muted">{award.meta}</p>
      </article>
    ))}
  </div>
</section>
