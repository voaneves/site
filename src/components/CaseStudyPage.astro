---
import Icon from './Icon.astro';
import { UI, type Locale } from '../i18n/ui';
import { PORTFOLIO, type ProjectCase } from '../data/portfolio';
import Words from './Words.astro';
import { CASE_IMAGE_SIZES, caseImageSrcset } from '../data/case-image';
import '../styles/sections/case.css';

export interface Props {
  locale: Locale;
  project: ProjectCase;
  prevProject: ProjectCase;
  nextProject: ProjectCase;
}

const { locale, project, prevProject, nextProject } = Astro.props;
const c = PORTFOLIO[locale];
const homeHref = locale === 'en' ? '/en/' : '/';
const caseBase = locale === 'en' ? '/en/projects' : '/projetos';
---

<article class="vn-case">
  <section class="vn-case-hero" data-surface="inverse">
    <div class="vn-container">
      <div class="vn-case-topbar">
        <nav class="vn-case-crumb" aria-label={UI[locale].breadcrumbLabel}>
          <a href={homeHref}>{c.caseUi.breadcrumbHome}</a>
          <span aria-hidden="true">/</span>
          <a href={`${homeHref}#projetos`}>{c.caseUi.breadcrumbProjects}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{project.index}</span>
        </nav>
        <a class="vn-btn vn-btn--ghost vn-btn--sm vn-case-back" href={`${homeHref}#projetos`}>
          <span aria-hidden="true">←</span>
          <span>{UI[locale].backProjects}</span>
        </a>
      </div>

      <div class="vn-case-hero__meta">
        <p class="vn-eyebrow vn-case-eyebrow" data-fx="scramble"><span aria-hidden="true">[ </span>Case — {project.year}<span aria-hidden="true"> ]</span></p>
        <span class="vn-case-badge">{project.metricBadge}</span>
      </div>

      <h1 class="vn-type-h1 vn-case-hero__title">{project.title}</h1>
      <p class="vn-type-lead vn-numbers-sub vn-measure">{project.summary}</p>

      <div class="vn-case-media" data-vt={project.slug}>
        <img
          src={project.image}
          srcset={caseImageSrcset(project.image)}
          sizes={CASE_IMAGE_SIZES}
          alt={project.imageAlt}
          width="1600"
          height="800"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="vn-case-kpis" data-stagger>
        {project.heroMetrics.map((kpi) => (
          <div class="vn-case-kpi" data-enter>
            <span class="vn-type-h2 vn-case-kpi__val">{kpi.value}</span>
            <span class="vn-type-body-sm vn-numbers-sub">{kpi.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="vn-section">
    <div class="vn-container">
      <div class="vn-case-grid">
        <aside class="vn-case-aside" data-stagger>
          <dl class="vn-spec-list" data-enter="left">
            <div class="vn-spec-list__row">
              <dt class="vn-type-label vn-muted">{c.caseUi.clientLabel}</dt>
              <dd class="vn-type-body-strong">{project.client}</dd>
            </div>
            <div class="vn-spec-list__row">
              <dt class="vn-type-label vn-muted">{c.caseUi.yearLabel}</dt>
              <dd class="vn-type-body-strong">{project.year}</dd>
            </div>
            <div class="vn-spec-list__row">
              <dt class="vn-type-label vn-muted">{c.caseUi.categoryLabel}</dt>
              <dd class="vn-type-body-strong">{project.category}</dd>
            </div>
          </dl>

          <div class="vn-case-block" data-enter="left">
            <h2 class="vn-type-label vn-sec-tag">{c.caseUi.deliverablesTitle}</h2>
            <ul class="vn-service-card__list">
              {project.deliverables.map((d) => (
                <li class="vn-type-body-sm">{d}</li>
              ))}
            </ul>
          </div>

          <ul class="vn-chip-list" data-enter="left">
            {project.tags.map((tag) => (
              <li class="vn-chip">{tag}</li>
            ))}
          </ul>

          {project.externalUrl && (
            <a
              class="vn-btn vn-btn--primary vn-btn--md"
              href={project.externalUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="globe" size={18} />
              <span>{c.caseUi.liveLinkLabel}</span>
            </a>
          )}
        </aside>

        <div class="vn-case-prose">
          <section class="vn-case-chapter" data-cursor-zone="read" data-stagger>
            <h2 class="vn-type-h3" data-enter="mask"><Words text={c.caseUi.challengeTitle} /></h2>
            <p class="vn-type-lead vn-muted" data-enter="lines">{project.challenge}</p>
          </section>

          <section class="vn-case-chapter" data-cursor-zone="read" data-stagger>
            <h2 class="vn-type-h3" data-enter="mask"><Words text={c.caseUi.architectureTitle} /></h2>
            <p class="vn-type-lead vn-muted" data-enter="lines">{project.architecture}</p>
          </section>

          <section class="vn-case-chapter" data-cursor-zone="read">
            <h2 class="vn-type-h3" data-enter="mask"><Words text={c.caseUi.outcomesTitle} /></h2>
            <ul class="vn-case-outcomes" data-stagger>
              {project.outcomes.map((out) => (
                <li class="vn-type-lead" data-enter="right">{out}</li>
              ))}
            </ul>
          </section>
        </div>
      </div>

      <nav class="vn-case-pager" aria-label={UI[locale].projectNavLabel} data-enter>
        <a class="vn-case-pager__link" href={`${caseBase}/${prevProject.slug}/`}>
          <span class="vn-type-micro vn-muted">← {c.caseUi.prevProject}</span>
          <strong class="vn-type-body-strong">{prevProject.title}</strong>
        </a>
        <a class="vn-case-pager__link vn-case-pager__link--next" href={`${caseBase}/${nextProject.slug}/`}>
          <span class="vn-type-micro vn-muted">{c.caseUi.nextProject} →</span>
          <strong class="vn-type-body-strong">{nextProject.title}</strong>
        </a>
      </nav>
    </div>
  </section>

  <section class="vn-section" data-surface="signal">
    <div class="vn-container vn-case-cta" data-stagger>
      <h2 class="vn-type-h2" data-enter="mask"><Words text={c.caseUi.ctaHeading} /></h2>
      <div data-enter><a class="vn-btn vn-btn--primary vn-btn--lg vn-magnetic" data-magnetic data-cursor-label={locale === 'en' ? 'TALK' : 'FALAR'} href={`${homeHref}#contato`}>
        <span>{c.caseUi.ctaButton}</span>
      </a></div>
      <p data-enter><a class="vn-type-body-strong" href={`${homeHref}#servicos`}>{c.caseUi.servicesLink}</a></p>
    </div>
  </section>
</article>
