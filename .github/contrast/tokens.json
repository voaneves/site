{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "voaneves.com colors actually used for text, links, buttons and focus. Values mirror the vendored @voaneves/brand tokens (node_modules/@voaneves/brand/dist/css/tokens.css) and the per-section grounds in src/styles/sections/themes.css:15-52. Light in $value, dark in $extensions.vn.dark.",
  "ground": {
    "a": {
      "bg": {
        "$type": "color",
        "$description": "Grounds #inicio #expertise #projetos #perguntas; paper / ink-950 (themes.css:2,15,24,28)",
        "$value": "#fdfbf6",
        "$extensions": {
          "vn": {
            "dark": "#0a0a0a"
          }
        }
      },
      "fg": {
        "$type": "color",
        "$description": "--g-fg (themes.css:16,25)",
        "$value": "#0a0a0a",
        "$extensions": {
          "vn": {
            "dark": "#e8dec5"
          }
        }
      },
      "muted": {
        "$type": "color",
        "$description": "--g-muted sand-800 / sand-500",
        "$value": "#5c5446",
        "$extensions": {
          "vn": {
            "dark": "#a69c86"
          }
        }
      },
      "link": {
        "$type": "color",
        "$description": "--g-red red-800 / red-450 (signal-ink)",
        "$value": "#b80000",
        "$extensions": {
          "vn": {
            "dark": "#ff3838"
          }
        }
      },
      "focus": {
        "$type": "color",
        "$description": "--vn-focus = signal red-600 / red-450",
        "$value": "#f50000",
        "$extensions": {
          "vn": {
            "dark": "#ff3838"
          }
        }
      }
    },
    "b": {
      "bg": {
        "$type": "color",
        "$description": "Grounds #quem-sou #jornada #servicos footer; cream-300 / ink-1000 (themes.css:19,29)",
        "$value": "#e8dec5",
        "$extensions": {
          "vn": {
            "dark": "#000000"
          }
        }
      },
      "fg": {
        "$type": "color",
        "$description": "--g-fg",
        "$value": "#0a0a0a",
        "$extensions": {
          "vn": {
            "dark": "#e8dec5"
          }
        }
      },
      "muted": {
        "$type": "color",
        "$description": "--g-muted",
        "$value": "#5c5446",
        "$extensions": {
          "vn": {
            "dark": "#a69c86"
          }
        }
      },
      "link": {
        "$type": "color",
        "$description": "--g-red",
        "$value": "#b80000",
        "$extensions": {
          "vn": {
            "dark": "#ff3838"
          }
        }
      },
      "focus": {
        "$type": "color",
        "$description": "--vn-focus",
        "$value": "#f50000",
        "$extensions": {
          "vn": {
            "dark": "#ff3838"
          }
        }
      }
    },
    "c": {
      "bg": {
        "$type": "color",
        "$description": "Ground #numeros (dark in both themes) and dark #projetos; ink-950 / ink-900 (themes.css:23,33)",
        "$value": "#0a0a0a",
        "$extensions": {
          "vn": {
            "dark": "#1a1a1a"
          }
        }
      },
      "fg": {
        "$type": "color",
        "$description": "--g-fg cream-300",
        "$value": "#e8dec5",
        "$extensions": {
          "vn": {
            "dark": "#e8dec5"
          }
        }
      },
      "muted": {
        "$type": "color",
        "$description": "--g-muted sand-500",
        "$value": "#a69c86",
        "$extensions": {
          "vn": {
            "dark": "#a69c86"
          }
        }
      },
      "link": {
        "$type": "color",
        "$description": "--g-red red-450",
        "$value": "#ff3838",
        "$extensions": {
          "vn": {
            "dark": "#ff3838"
          }
        }
      },
      "focus": {
        "$type": "color",
        "$description": "--vn-focus in color-scheme dark",
        "$value": "#ff3838",
        "$extensions": {
          "vn": {
            "dark": "#ff3838"
          }
        }
      },
      "tag": {
        "$type": "color",
        "$description": "--vn-sec-tag-dark red-400 (sections/base.css:44)",
        "$value": "#ff5a5a",
        "$extensions": {
          "vn": {
            "dark": "#ff5a5a"
          }
        }
      }
    }
  },
  "card": {
    "bg": {
      "$type": "color",
      "$description": "--vn-surface-raised: #fff / ink-soft (themes.css:6)",
      "$value": "#ffffff",
      "$extensions": {
        "vn": {
          "dark": "#1a1a1a"
        }
      }
    },
    "fg": {
      "$type": "color",
      "$description": "--vn-text",
      "$value": "#0a0a0a",
      "$extensions": {
        "vn": {
          "dark": "#e8dec5"
        }
      }
    },
    "muted": {
      "$type": "color",
      "$description": "--vn-text-muted",
      "$value": "#5c5446",
      "$extensions": {
        "vn": {
          "dark": "#a69c86"
        }
      }
    }
  },
  "button": {
    "primary": {
      "bg": {
        "$type": "color",
        "$description": "brand button-primary-bg ink / text (tokens.css:287)",
        "$value": "#0a0a0a",
        "$extensions": {
          "vn": {
            "dark": "#e8dec5"
          }
        }
      },
      "fg": {
        "$type": "color",
        "$description": "brand button-primary-fg",
        "$value": "#f4ead4",
        "$extensions": {
          "vn": {
            "dark": "#0a0a0a"
          }
        }
      }
    },
    "signal": {
      "bg": {
        "$type": "color",
        "$description": "brand button-signal-bg = signal",
        "$value": "#f50000",
        "$extensions": {
          "vn": {
            "dark": "#ff3838"
          }
        }
      },
      "fg": {
        "$type": "color",
        "$description": "brand button-signal-fg = ink",
        "$value": "#0a0a0a",
        "$extensions": {
          "vn": {
            "dark": "#0a0a0a"
          }
        }
      }
    }
  },
  "contact": {
    "bg": {
      "$type": "color",
      "$description": "sections/contact.css:5, red-600 in both themes",
      "$value": "#f50000",
      "$extensions": {
        "vn": {
          "dark": "#f50000"
        }
      }
    },
    "fg": {
      "$type": "color",
      "$description": "ink on signal",
      "$value": "#0a0a0a",
      "$extensions": {
        "vn": {
          "dark": "#0a0a0a"
        }
      }
    }
  }
}
